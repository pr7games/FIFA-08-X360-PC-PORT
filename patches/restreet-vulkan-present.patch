+// Observe successfully queued host presents, not physical scanout timestamps.
+void LogPresentSequence(const void* presenter, uint64_t sequence) {
+  if (!REXCVAR_GET(vulkan_log_present_timing) || !sequence) return;
+  using Clock = std::chrono::steady_clock;
+  struct Stats {
+    const void* owner = nullptr;
+    Clock::time_point start = Clock::now(), last_new = {};
+    uint64_t last_sequence = 0, presents = 0, repeated = 0, skipped = 0;
+    std::vector<double> intervals;
+  };
+  static thread_local Stats stats;
+  if (stats.owner != presenter) { stats = Stats{}; stats.owner = presenter; }
+  const auto now = Clock::now();
+  ++stats.presents;
+  if (sequence == stats.last_sequence) {
+    ++stats.repeated;
+  } else {
+    if (stats.last_sequence) {
+      if (sequence > stats.last_sequence + 1) stats.skipped += sequence - stats.last_sequence - 1;
+      stats.intervals.push_back(std::chrono::duration<double, std::milli>(now - stats.last_new).count());
+    }
+    stats.last_sequence = sequence;
+    stats.last_new = now;
+  }
+  const double elapsed = std::chrono::duration<double>(now - stats.start).count();
+  if (elapsed < 5.0) return;
+  std::sort(stats.intervals.begin(), stats.intervals.end());
+  const size_t count = stats.intervals.size();
+  REXLOG_INFO("VulkanFrameCadence: seconds={:.3f} presents={} repeated={} skipped={} "
+              "new_frame_ms median={:.3f} p95={:.3f} max={:.3f}", elapsed, stats.presents,
+              stats.repeated, stats.skipped, count ? stats.intervals[count / 2] : 0.0,
+              count ? stats.intervals[(count - 1) * 95 / 100] : 0.0,
+              count ? stats.intervals.back() : 0.0);
+  stats.start = now;
+  stats.presents = stats.repeated = stats.skipped = 0;
+  stats.intervals.clear();
+}
+
+// CPU timings only: no GPU queries, waits, or presentation policy changes.
+struct PresentTiming {
+  using Clock = std::chrono::steady_clock;
+  bool enabled = REXCVAR_GET(vulkan_log_present_timing);
+  bool acquire_timeout = false;
+  Clock::time_point previous = enabled ? Clock::now() : Clock::time_point{};
+  std::array<double, 5> stages{};
+
+  void Mark(size_t stage) {
+    if (!enabled) return;
+    auto now = Clock::now();
+    stages[stage] = std::chrono::duration<double, std::milli>(now - previous).count();
+    previous = now;
+  }
+
+  ~PresentTiming() {
+    if (!enabled) return;
+    struct Stats {
+      Clock::time_point start = Clock::now();
+      uint64_t count = 0;
+      uint64_t timeouts = 0;
+      std::array<double, 5> sums{};
+      std::array<double, 5> maxima{};
+    };
+    static thread_local Stats stats;
+    ++stats.count;
+    stats.timeouts += acquire_timeout ? 1 : 0;
+    for (size_t i = 0; i < stages.size(); ++i) {
+      stats.sums[i] += stages[i];
+      stats.maxima[i] = std::max(stats.maxima[i], stages[i]);
+    }
+    if (Clock::now() - stats.start < std::chrono::seconds(5)) return;
+    REXLOG_INFO(
+        "VulkanPresentTiming: calls={} timeouts={} CPU ms avg/max "
+        "reuse={:.3f}/{:.3f} acquire={:.3f}/{:.3f} record={:.3f}/{:.3f} "
+        "submit={:.3f}/{:.3f} present={:.3f}/{:.3f}",
+        stats.count, stats.timeouts,
+        stats.sums[0] / stats.count, stats.maxima[0],
+        stats.sums[1] / stats.count, stats.maxima[1],
+        stats.sums[2] / stats.count, stats.maxima[2],
+        stats.sums[3] / stats.count, stats.maxima[3],
+        stats.sums[4] / stats.count, stats.maxima[4]);
+    stats = Stats{};
+  }
+};
+
+}  // namespace
